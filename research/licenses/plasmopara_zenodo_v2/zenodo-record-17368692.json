{"created": "2025-10-16T13:04:29.140080+00:00", "modified": "2025-10-16T13:04:29.304533+00:00", "id": 17368692, "conceptrecid": "17278431", "doi": "10.5281/zenodo.17368692", "conceptdoi": "10.5281/zenodo.17278431", "doi_url": "https://doi.org/10.5281/zenodo.17368692", "metadata": {"title": "A dataset for early detection and classification of Plasmopara disease", "doi": "10.5281/zenodo.17368692", "publication_date": "2025-10-16", "description": "<p><span lang=\"EN-GB\">This is a novel image dataset of grapevine leaves aimed at early detection and classification of <em><span>Plasmopara viticola</span></em>, the pathogen causing downy mildew in vineyards. The dataset consists of 281 high-resolution images, annotated into two classes: healthy and <em><span>Plasmopara</span></em>-infected leaves. Data were collected from vineyards in Spain and Norway to ensure diverse environmental conditions and maximize the dataset&rsquo;s generalizability.</span></p>", "access_right": "open", "creators": [{"name": "Shaikh, Sarang", "affiliation": "Norwegian University of Science and Technology", "orcid": "0000-0003-2099-4797"}, {"name": "Mobeen, Noor E", "affiliation": "Norwegian University of Science and Technology"}, {"name": "Abomhara, Mohamed", "affiliation": "Norwegian University of Science and Technology", "orcid": "0000-0001-9151-7694"}, {"name": "Ballesteros, Rocio", "affiliation": "Universidad de Castilla-La Mancha - Campus de Albacete", "orcid": "0000-0001-6496-4421"}, {"name": "Arias-Calder\u00f3n, Roc\u00edo", "affiliation": "Universidad de Castilla-La Mancha - Campus de Albacete: Albacete, Castilla-La Mancha, ES", "orcid": "0000-0002-5101-0036"}, {"name": "YILDIRIM-YAYILGAN, SULE", "affiliation": "Norwegian University of Science and Technology", "orcid": "0000-0002-1982-6609"}, {"name": "Moreno, Miguel A", "affiliation": "Universidad de Castilla-La Mancha"}], "resource_type": {"title": "Dataset", "type": "dataset"}, "license": {"id": "cc-by-4.0"}, "grants": [{"code": "101